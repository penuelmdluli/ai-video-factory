# === AI APIs ===
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# === Voice ===
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# === Stock Footage ===
PEXELS_API_KEY=your_pexels_api_key

# === YouTube ===
# OAuth token stored in tokens/youtube_token.json
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret

# === TikTok ===
# Uses browser cookies stored in tokens/cookies.txt

# === Instagram ===
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_USER_ID=your_instagram_user_id

# === Twitter/X ===
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# === Monitoring ===
ALERT_EMAIL=your_email@example.com
GOOGLE_SHEETS_ID=your_google_sheets_id

# === Remote Control (Telegram) ===
# Control the factory from your phone. See REMOTE_CONTROL.md for setup.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token          # from @BotFather
TELEGRAM_ALLOWED_CHAT_IDS=                          # comma-separated chat ids (send /id to your bot)
GITHUB_TOKEN=your_github_pat                        # needs actions:write (fine-grained) or repo (classic)
GITHUB_REPO=penuelmdluli/ai-video-factory
GENESIS_WORKFLOW_FILE=genesis-content-engine.yml
GENESIS_WORKFLOW_REF=main

# === Settings ===
OUTPUT_DIR=./output
DEFAULT_VOICE_YOUTUBE=elevenlabs
DEFAULT_VOICE_SHORTS=edge-tts
VIDEOS_PER_DAY=2
